{
    "name": "eg-media/eg-media",
    "description": "Gestionnaire de Média by EG",
    "type": "wordpress-plugin",
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "scripts": {
        "stan": "phpstan analyze --debug --memory-limit=2G",
        "lint": "phpcs",
        "fix": "phpcbf",
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "EG_MEDIA\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EG_MEDIA\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
