<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="EG_Media_WordPress_Standards" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Standard de code WordPress 7.1+ moderne (PHP 8.4 + PHPStan Level 8 + PSR-4) pour EG Media Manager.</description>

    <!-- ================================================================== -->
    <!-- 1. PARAMÈTRES D'EXÉCUTION & PERFORMANCE                            -->
    <!-- ================================================================== -->
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs.cache"/>
    <config name="ignore_warnings_on_exit" value="0"/>

    <!-- Versions cibles : WordPress 7.1 et PHP 8.4 minimum -->
    <config name="minimum_wp_version" value="7.1" />
    <config name="testVersion" value="8.4-"/>

    <!-- ================================================================== -->
    <!-- 2. FICHIERS ET DOSSIERS À ANALYSER / EXCLURE                       -->
    <!-- ================================================================== -->
    <file>eg-media.php</file>
    <file>uninstall.php</file>
    <file>includes</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/dist-temp/*</exclude-pattern>
    <exclude-pattern>*/index.php</exclude-pattern>

    <!-- ================================================================== -->
    <!-- 3. STANDARDS DE BASE & MODERNISATION PHP 8.4 / PSR-4               -->
    <!-- ================================================================== -->
    <rule ref="WordPress-Core">
        <exclude name="WordPress.Files.FileName" />
        <exclude name="WordPress.PHP.YodaConditions" />
    </rule>

    <rule ref="WordPress-Extra">
        <exclude name="Universal.Operators.DisallowShortTernary" />
        <exclude name="Universal.Arrays.DisallowShortArraySyntax" />
    </rule>

    <rule ref="PHPCompatibilityWP" />
    <rule ref="Generic.PHP.RequireStrictTypes" />
    <rule ref="Generic.Arrays.DisallowLongArraySyntax" />

    <!-- ================================================================== -->
    <!-- 4. CONFIGURATION SPÉCIFIQUE WORDPRESS (i18n & Capacités)           -->
    <!-- ================================================================== -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="eg-media" />
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.Capabilities">
        <properties />
    </rule>

    <!-- ================================================================== -->
    <!-- 5. EXCEPTIONS ARCHITECTURALES DU PROJET                            -->
    <!-- ================================================================== -->
    <!-- Autoriser error_log uniquement dans la classe utilitaire Logger -->
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <exclude-pattern>includes/Utils/Logger.php</exclude-pattern>
    </rule>

    <!-- Autoriser les requêtes directes SQL dans les Repositories -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>includes/Repositories/*</exclude-pattern>
    </rule>

    <!-- Autoriser la manipulation directe de $_POST/$_GET/$_REQUEST dans la couche Request -->
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>includes/Utils/Request.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <exclude-pattern>includes/Utils/Request.php</exclude-pattern>
    </rule>

    <!-- Ignorer le faux positif PHPCompatibility sur $this dans les Enums PHP 8.1+ -->
    <rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts">
        <exclude-pattern>includes/Enums/*</exclude-pattern>
    </rule>

</ruleset>
