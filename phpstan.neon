parameters:
    level: 7
    phpVersion: 80400 # Force l'analyse pour PHP 8.4

    # =========================================================================
    # 1. OPTIONS DE RIGUEUR (Alternative propre au mode "Strict" global)
    # =========================================================================
    treatPhpDocTypesAsCertain: false
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    checkExplicitMixedMissingReturn: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true

    # =========================================================================
    # 2. GESTION DES ERREURS IGNORÉES
    # =========================================================================
    # Mettre à "true" une fois le Level 8 atteint pour nettoyer les vieux @phpstan-ignore inutiles
    reportUnmatchedIgnoredErrors: false

    # =========================================================================
    # 3. FICHIERS ET DOSSIERS À ANALYSER
    # =========================================================================
    paths:
        - eg-media.php
        - includes/

    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    
    scanFiles:
        - eg-media.php
